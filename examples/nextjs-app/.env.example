# Required: a random secret for session cookies. Make one with: openssl rand -base64 32
AUTH_SECRET=

# Optional. Leave all three empty to run the simulated demo with the public test address and key.
# For a real site, use a throwaway address used only for logins and its read-only unified full
# viewing key (uview1... or uviewtest1...). Never a spending key or a seed phrase.
LOGIN_SITE_ID=
LOGIN_ADDRESS=
LOGIN_UFVK=

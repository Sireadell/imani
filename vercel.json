{
  "git": { "deploymentEnabled": { "main": true, "site-home": false, "site-result": false } },
  "buildCommand": "npm run site:build",
  "outputDirectory": "site",
  "functions": {
    "api/block.mjs": {
      "maxDuration": 60,
      "includeFiles": "vendor/decoder/**"
    },
    "api/check.mjs": {
      "maxDuration": 10,
      "includeFiles": "{vendor/decoder/**,examples/testnet-01/**,examples/mainnet-01/**}"
    }
  }
}


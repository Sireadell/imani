{
  "name": "imani",
  "version": "0.0.1",
  "description": "Check that a sealed-bid auction on Zcash was fair, and sign in with a private Zcash wallet.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "bin": {
    "imani": "bin/imani.js"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "test:login": "tsx --test test/login/*.test.ts",
    "typecheck": "tsc --noEmit",
    "demo": "node --disable-warning=ExperimentalWarning tools/demo.ts",
    "examples": "node --disable-warning=ExperimentalWarning tools/make-examples.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}

{
  "name": "imani",
  "version": "0.0.1",
  "description": "Check that a sealed-bid auction on Zcash was fair, and sign in with a private Zcash wallet.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "files": [
    "bin",
    "dist",
    "vendor/decoder",
    "examples",
    "!examples/nextjs-app",
    "README.md",
    "SPEC.md",
    "LOGIN_SPEC.md",
    "THIRD_PARTY.md",
    "LICENSE"
  ],
  "exports": {
    "./login": {
      "types": "./dist/types/login/index.d.ts",
      "default": "./dist/login.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "imani": "bin/imani.js"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node --disable-warning=ExperimentalWarning tools/package-build.ts",
    "prepare": "npm run build",
    "test": "tsx --test test/*.test.ts",
    "login:scorecard": "tsx tools/login-scorecard.ts",
    "test:all": "node --disable-warning=ExperimentalWarning tools/test-all.ts",
    "test:login": "tsx --test test/login/*.test.ts",
    "test:fetch": "tsx --test test/fetch/*.test.ts",
    "test:demo": "tsx --test test/demo/*.test.ts",
    "test:scan": "tsx --test test/scan/*.test.ts",
    "demo:app": "tsx demo/server.ts",
    "typecheck": "tsc --noEmit",
    "leak-scan": "node --disable-warning=ExperimentalWarning tools/leak-scan.ts",
    "demo": "node --disable-warning=ExperimentalWarning tools/demo.ts",
    "examples": "node --disable-warning=ExperimentalWarning tools/make-examples.ts",
    "test:site": "tsx --test test/site/*.test.ts",
    "site:build": "node --disable-warning=ExperimentalWarning tools/site-build.ts",
    "relay:build": "node --disable-warning=ExperimentalWarning tools/relay-build.ts",
    "site:serve": "node --disable-warning=ExperimentalWarning tools/site-serve.ts",
    "examples:memo": "node --disable-warning=ExperimentalWarning tools/make-memo-examples.ts",
    "examples:receivers": "node --disable-warning=ExperimentalWarning tools/make-receiver-examples.ts",
    "test:tamper": "tsx --test test/tamper/*.test.ts",
    "check:external": "tsx tools/external-check.ts",
    "test:external": "tsx --test test/external/*.test.ts",
    "test:privacy": "tsx --test test/privacy/*.test.ts",
    "who-learns": "node --disable-warning=ExperimentalWarning tools/who-learns.ts",
    "leak-scan:history": "node --disable-warning=ExperimentalWarning tools/leak-scan.ts --history"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
